<UserControl x:Class="pcb_deftek.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:pcb_deftek.Presentation.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="M3,3H10V10H3V3M14,3H21V10H14V3M3,14H10V21H3V14M14,14H21V21H14V14Z"
                  Fill="{DynamicResource AccentFillColorDefaultBrush}"
                  Width="48" Height="48"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,16" />
            <TextBlock Text="Defect Statistics Dashboard"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Phase 8 delivery: Interactive metric cards (Total PCBs, Defects, PASS/FAIL line chart, Distribution bar chart), multi-scale date &amp; severity filters, and root-cause diagnostic accordions."
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       TextAlignment="Center"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border x:Name="ChartModalOverlay"
                Background="#66000000"
                Visibility="{Binding IsChartModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                AutomationProperties.Name="Enlarged dashboard chart dialog"
                PreviewKeyDown="OnChartModalPreviewKeyDown">
            <Border x:Name="ChartModalDialog"
                    MaxWidth="920"
                    Margin="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,12">
                        <TextBlock Text="{Binding ActiveChartCard.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding ActiveChartCard.AccessibleSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button x:Name="ChartModalCloseButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding CloseChartCommand}"
                            AutomationProperties.Name="Close enlarged chart"
                            ToolTip="Close">
                        <TextBlock Text="×"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <controls:DashboardChartHost x:Name="ModalChartHost"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Card="{Binding ActiveChartCard}"
                                                 Height="360"
                                                 ChartActivated="OnChartActivated" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
