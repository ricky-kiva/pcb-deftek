<UserControl x:Class="pcb_deftek.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:pcb_deftek.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="680"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/pcb-deftek;component/Presentation/Styles/StatusColors.xaml" />
                <ResourceDictionary Source="/pcb-deftek;component/Presentation/Styles/Icons.xaml" />
                <ResourceDictionary Source="/pcb-deftek;component/Presentation/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28,24"
            MaxWidth="680"
            MaxHeight="740"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Opacity="0.25"
                              ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Modal Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Scrollable Settings Body -->
                <RowDefinition Height="*" />
                <!-- Row 2: Modal Action Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Modal Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Button DockPanel.Dock="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource FooterLinkButtonStyle}"
                        Width="32" Height="32"
                        ToolTip="Close settings"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IconClose}"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                          Width="12" Height="12"
                          Stretch="Uniform" />
                </Button>

                <StackPanel>
                    <TextBlock Text="Settings &amp; Attribution"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Configure runtime parameters, hardware acceleration, and application behavior."
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Section 1: Inference & Model Controls -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Inference &amp; Model Controls"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <!-- Confidence Threshold -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Confidence Threshold"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Minimum model probability required to register a PCB defect."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfidencePercentageText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Minimum="0.05"
                                        Maximum="1.00"
                                        SmallChange="0.05"
                                        LargeChange="0.10"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ConfidenceThreshold, Mode=TwoWay}"
                                        Margin="0,8,0,0" />
                            </Grid>

                            <!-- Hardware Device Selector -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Detection Device"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Hardware execution provider for tensor inference."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          Height="32"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Application Preferences -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Application Preferences"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <!-- Default Startup Page -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Default Startup Page"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Page presented when the application launches."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableStartupPages}"
                                          SelectedItem="{Binding SelectedStartupPage, Mode=TwoWay}"
                                          Height="32"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Export & Image Directories -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Export &amp; Image Directories"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <!-- Report Export Path -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="{StaticResource IconDocument}"
                                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Report Export Directory"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="PDF audit reports are written here."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding ReportExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Padding="6,2" />
                            </StackPanel>

                            <!-- Crop Output Path -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="{StaticResource IconImage}"
                                          Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Image Output Directory"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Cropped and live-captured inspection images are written here."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding ImageOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Padding="6,2" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 3b: Database Backup -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconDatabase}"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Database Backup Directory"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Point-in-time SQLite snapshots are written here."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding DatabaseExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="6,2" />

                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Left"
                                        Command="{Binding ExportDatabaseCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExport}"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="0,0,8,0" />
                                        <TextBlock Text="Export Database Snapshot" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="{Binding ExportStatusMessage}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: Attribution -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Attribution"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <!-- Model Information -->
                            <TextBlock Text="Model"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Model Name:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Width="90" />
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://huggingface.co/Janani-V/pcb-defect-yolov8m-dspcbsd"
                                        Style="{StaticResource FooterLinkButtonStyle}">
                                    <TextBlock Text="pcb-defect-yolov8m-dspcbsd" FontSize="12" TextDecorations="Underline" />
                                </Button>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Developer:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Width="90" />
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/Janviswa"
                                        Style="{StaticResource FooterLinkButtonStyle}">
                                    <TextBlock Text="Janani-V" FontSize="12" TextDecorations="Underline" />
                                </Button>
                            </DockPanel>

                            <!-- Application Developer Information -->
                            <TextBlock Text="Developer"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Author:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Width="90" />
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://rickyslash.my.id"
                                        Style="{StaticResource FooterLinkButtonStyle}">
                                    <TextBlock Text="Rickyslash" FontSize="12" FontWeight="Medium" TextDecorations="Underline" />
                                </Button>
                            </DockPanel>

                            <!-- Social Icons & Ko-fi row -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0">
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/ricky-kiva"
                                        Style="{StaticResource FooterLinkButtonStyle}"
                                        ToolTip="GitHub: ricky-kiva">
                                    <Path Data="{StaticResource IconGitHub}"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Width="14" Height="14"
                                          Stretch="Uniform" />
                                </Button>
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://instagram.com/r.ckyslash"
                                        Style="{StaticResource FooterLinkButtonStyle}"
                                        ToolTip="Instagram: r.ckyslash"
                                        Margin="4,0,0,0">
                                    <Path Data="{StaticResource IconInstagram}"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Width="14" Height="14"
                                          Stretch="Uniform" />
                                </Button>
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://linkedin.com/ricky-fadel"
                                        Style="{StaticResource FooterLinkButtonStyle}"
                                        ToolTip="LinkedIn: ricky-fadel"
                                        Margin="4,0,0,0">
                                    <Path Data="{StaticResource IconLinkedIn}"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Width="14" Height="14"
                                          Stretch="Uniform" />
                                </Button>
                                <Button Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://ko-fi.com/rickyslash"
                                        Style="{StaticResource FooterLinkButtonStyle}"
                                        ToolTip="Buy Me a Coffee on Ko-fi"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCoffee}"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                                        <TextBlock Text="Support on Ko-fi" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Modal Action Footer -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,16,0,0"
                    Padding="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CloseCommand}"
                            Content="Cancel"
                            Width="90" Height="32"
                            Margin="0,0,10,0"
                            Cursor="Hand" />
                    <Button Command="{Binding SaveCommand}"
                            Content="Save Changes"
                            Width="110" Height="32"
                            Cursor="Hand"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
