<UserControl x:Class="pcb_deftek.Presentation.Views.LiveDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:pcb_deftek.Presentation.ViewModels"
             xmlns:converters="clr-namespace:pcb_deftek.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LiveDetectionViewModel}"
             d:DesignHeight="720" d:DesignWidth="1100"
             Focusable="True"
             PreviewMouseMove="OnViewportPreviewMouseMove"
             PreviewMouseDown="OnViewportPreviewMouseDown"
             PreviewKeyDown="OnViewportPreviewKeyDown"
             Loaded="OnViewLoaded"
             Unloaded="OnViewUnloaded">

    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding CaptureSnapshotCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Theme-Adaptive Floating HUD Card Style -->
        <Style x:Key="LiveHudCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Primary Capture Action Button Style -->
        <Style x:Key="CaptureFrameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CaptureActionBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Telemetry Toggle CheckBox (subtle container fill; no system accent) -->
        <Style x:Key="TelemetryCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="CheckBoxSurface"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckGlyph"
                                      Data="M 2,8 L 7,13 L 14,4"
                                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxSurface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Full-Screen Optical Video Stage -->
    <Grid x:Name="RootViewportGrid"
          Background="#121212"
          ClipToBounds="True">

        <!-- Live Camera Stream Viewport (Uniform Aspect Ratio) -->
        <Image x:Name="LiveVideoImage"
               Source="{Binding CurrentFrameImage}"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.Name="Live PCB Inspection Video Feed" />

        <!-- Meaningful Standby / Initializing Overlay when no frame has arrived yet -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentFrameImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="#1FFFFFFF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <Path Data="{DynamicResource IconLiveDetection}"
                      Fill="#CCFFFFFF"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Live Optical Inspection Feed"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F2FFFFFF"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="#A6FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- TOP-RIGHT FLOATING HUD: 3-Card Vertical Stack -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Width="252">

            <!-- Card 1 (Persistent): Live PASS/FAIL Status Badge + Detected Defect Counter -->
            <Border x:Name="StatusHudCard"
                    Style="{StaticResource LiveHudCardBorderStyle}"
                    Margin="0,0,0,10"
                    Opacity="1.0"
                    AutomationProperties.Name="Live Inspection Status Card">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- High-Contrast PASS / FAIL Badge -->
                    <Border Grid.Column="0"
                            CornerRadius="4"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#107C41" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPass}" Value="False">
                                        <Setter Property="Background" Value="#C42B1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Detected Defect Counter -->
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DefectCountText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Active Frame"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2 (Persistent when telemetry enabled): Metrics Readout — Latency + Frame Rate -->
            <Border x:Name="TelemetryReadoutHudCard"
                    Style="{StaticResource LiveHudCardBorderStyle}"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsTelemetryEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Live Telemetry Readout Card">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Inference Latency (ms) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Latency"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding InferenceLatencyMs, StringFormat='{}{0:F1} ms'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Live FPS -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Frame Rate"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0} FPS'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3 (Configuration): Telemetry Toggle — auto-hides on stationary cursor -->
            <Border x:Name="TelemetryToggleHudCard"
                    Style="{StaticResource LiveHudCardBorderStyle}"
                    Margin="0,0,0,10"
                    Opacity="1.0"
                    AutomationProperties.Name="Telemetry Toggle Card">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Telemetry"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource TelemetryCheckBoxStyle}"
                              IsChecked="{Binding IsTelemetryEnabled, Mode=TwoWay}"
                              Content="Show"
                              FontSize="11"
                              ToolTip="Toggle real-time inference latency and FPS display"
                              AutomationProperties.Name="Toggle Telemetry Display" />
                </Grid>
            </Border>

            <!-- Card 4: Camera Source Selector Dropdown (Auto-Hides on Stationary Cursor) -->
            <Border x:Name="CameraSelectorHudCard"
                    Style="{StaticResource LiveHudCardBorderStyle}"
                    Opacity="1.0"
                    AutomationProperties.Name="Camera Source Selector Card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{DynamicResource IconLiveDetection}"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Camera Source"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding AvailableCameras}"
                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              FontSize="12"
                              Cursor="Hand"
                              ToolTip="Select active video capture camera"
                              AutomationProperties.Name="Camera Source Dropdown" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- BOTTOM-LEFT FLOATING CONTROL: Confidence Threshold Slider -->
        <Border x:Name="ConfidenceSliderHudCard"
                Style="{StaticResource LiveHudCardBorderStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20"
                Width="264"
                Opacity="1.0"
                AutomationProperties.Name="Confidence Threshold Control Card">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Confidence Threshold"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Border Grid.Column="1"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="6,2">
                        <TextBlock Text="{Binding ConfidencePercentageText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>

                <Slider Minimum="0.10"
                        Maximum="0.95"
                        SmallChange="0.01"
                        LargeChange="0.05"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        Value="{Binding ConfidenceThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Cursor="Hand"
                        ToolTip="Adjust minimum defect detection confidence threshold (10% - 95%)"
                        AutomationProperties.Name="Confidence Threshold Slider" />
            </StackPanel>
        </Border>

        <!-- BOTTOM-RIGHT FLOATING CONTROL: Capture Button with Space Shortcut Hint -->
        <Border x:Name="CaptureActionHudCard"
                Style="{StaticResource LiveHudCardBorderStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Padding="10,8"
                Opacity="1.0"
                AutomationProperties.Name="Capture Frame Control Card">
            <Button Style="{StaticResource CaptureFrameButtonStyle}"
                    Command="{Binding CaptureSnapshotCommand}"
                    ToolTip="Capture current frame to inspection history (Shortcut: Space)"
                    AutomationProperties.Name="Capture Frame Button">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IconCapture}"
                          Fill="#FFFFFF"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                    <TextBlock Text="Capture Frame"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Border Background="#2EFFFFFF"
                            BorderBrush="#4DFFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="Space"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
