<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Inspection Result Status Colors (PASS / FAIL) -->
    <Color x:Key="StatusPassColor">#107C41</Color>
    <Color x:Key="StatusPassLightColor">#DFF6DD</Color>
    <Color x:Key="StatusPassBorderColor">#83B896</Color>

    <Color x:Key="StatusFailColor">#C42B1C</Color>
    <Color x:Key="StatusFailLightColor">#FDE7E9</Color>
    <Color x:Key="StatusFailBorderColor">#E59792</Color>

    <SolidColorBrush x:Key="StatusPassBrush" Color="{StaticResource StatusPassColor}" />
    <SolidColorBrush x:Key="StatusPassLightBrush" Color="{StaticResource StatusPassLightColor}" />
    <SolidColorBrush x:Key="StatusPassBorderBrush" Color="{StaticResource StatusPassBorderColor}" />

    <SolidColorBrush x:Key="StatusFailBrush" Color="{StaticResource StatusFailColor}" />
    <SolidColorBrush x:Key="StatusFailLightBrush" Color="{StaticResource StatusFailLightColor}" />
    <SolidColorBrush x:Key="StatusFailBorderBrush" Color="{StaticResource StatusFailBorderColor}" />

    <!-- Defect Severity Level Brushes -->
    <Color x:Key="SeverityCriticalColor">#C42B1C</Color>
    <Color x:Key="SeverityHighColor">#D83B01</Color>
    <Color x:Key="SeverityMediumHighColor">#EA4A00</Color>
    <Color x:Key="SeverityMediumColor">#FF8C00</Color>
    <Color x:Key="SeverityLowMediumColor">#0078D4</Color>

    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="{StaticResource SeverityCriticalColor}" />
    <SolidColorBrush x:Key="SeverityHighBrush" Color="{StaticResource SeverityHighColor}" />
    <SolidColorBrush x:Key="SeverityMediumHighBrush" Color="{StaticResource SeverityMediumHighColor}" />
    <SolidColorBrush x:Key="SeverityMediumBrush" Color="{StaticResource SeverityMediumColor}" />
    <SolidColorBrush x:Key="SeverityLowMediumBrush" Color="{StaticResource SeverityLowMediumColor}" />

    <!-- Severity Light Tints for Badges -->
    <SolidColorBrush x:Key="SeverityCriticalTintBrush" Color="#1AC42B1C" />
    <SolidColorBrush x:Key="SeverityHighTintBrush" Color="#1AD83B01" />
    <SolidColorBrush x:Key="SeverityMediumHighTintBrush" Color="#1AEA4A00" />
    <SolidColorBrush x:Key="SeverityMediumTintBrush" Color="#1AFF8C00" />
    <SolidColorBrush x:Key="SeverityLowMediumTintBrush" Color="#1A0078D4" />

    <!-- Floating HUD Overlay & Telemetry Brushes -->
    <SolidColorBrush x:Key="HudCardBackgroundBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="HudCardBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="HudCardDarkBackgroundBrush" Color="#E6202020" />
    <SolidColorBrush x:Key="HudCardDarkBorderBrush" Color="#26FFFFFF" />

</ResourceDictionary>
