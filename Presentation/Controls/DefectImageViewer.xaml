<UserControl x:Class="pcb_deftek.Presentation.Controls.DefectImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:pcb_deftek.Presentation.Controls"
             xmlns:converters="clr-namespace:pcb_deftek.Presentation.Converters"
             x:Name="Root"
             Background="Transparent"
             ClipToBounds="True"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             SnapsToDevicePixels="True"
             SizeChanged="OnViewerSizeChanged"
             Loaded="OnViewerLoaded"
             IsVisibleChanged="OnViewerIsVisibleChanged"
             MouseWheel="OnViewerMouseWheel"
             MouseLeftButtonDown="OnViewerMouseLeftButtonDown"
             MouseMove="OnViewerMouseMove"
             MouseLeftButtonUp="OnViewerMouseLeftButtonUp"
             LostMouseCapture="OnViewerLostMouseCapture"
             MouseLeave="OnViewerMouseLeave">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />

        <Style x:Key="MarkerContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding PixelBounds.X}" />
            <Setter Property="Canvas.Top" Value="{Binding PixelBounds.Y}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <!--
        Canvas, not Grid: a Grid gives its child the parent's available size during measure,
        and a scene larger than the viewport receives a layout clip that is applied before the
        render transform — cropping the image to a fraction of the viewport when scaled down.
        Canvas measures children unbounded, so the scene keeps its pixel size and the render
        transform alone decides what is visible.
    -->
    <Canvas x:Name="ViewportSurface" Background="Transparent" ClipToBounds="True">
        <Grid x:Name="Scene"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
            <!--
                RenderTransform, not LayoutTransform: the viewport model maps image pixels to
                viewport units as (pixel * scale) + offset, and hit testing, panning and viewport
                cropping all consume that mapping. A LayoutTransform applies the scale but drops
                the translation during layout, so the drawn boxes would drift away from their
                clickable regions by the offset.
            -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SceneScale" />
                    <TranslateTransform x:Name="SceneTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="BoardImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />

            <ItemsControl x:Name="MarkerLayer"
                          ItemsSource="{Binding Markers, ElementName=Root}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource MarkerContainerStyle}" />
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding PixelBounds.Width}"
                              Height="{Binding PixelBounds.Height}"
                              ClipToBounds="False">
                            <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                    BorderThickness="2"
                                    Background="#12000000"
                                    CornerRadius="1" />
                            <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    Margin="-4"
                                    CornerRadius="2"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Canvas>
</UserControl>
