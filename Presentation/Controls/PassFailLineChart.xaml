<UserControl x:Class="pcb_deftek.Presentation.Controls.PassFailLineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             ClipToBounds="True"
             Focusable="True"
             IsTabStop="True"
             FocusVisualStyle="{DynamicResource ChartFocusVisualStyle}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnChartSizeChanged"
             Loaded="OnChartLoaded"
             MouseMove="OnChartMouseMove"
             MouseLeave="OnChartMouseLeave"
             MouseLeftButtonUp="OnChartMouseLeftButtonUp"
             KeyDown="OnChartKeyDown">
    <Grid x:Name="Surface" Background="Transparent">
        <Canvas x:Name="PlotCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="LabelCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="TooltipBorder"
                    Visibility="Collapsed"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="7,4">
                <TextBlock x:Name="TooltipText"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </Canvas>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,2,10,0"
                    IsHitTestVisible="False">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusPassBrush}" VerticalAlignment="Center" />
            <TextBlock Text="PASS" FontSize="9" Margin="4,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusFailBrush}" VerticalAlignment="Center" />
            <TextBlock Text="FAIL" FontSize="9" Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="EmptyStateText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"
                   Text="No PASS/FAIL data for this range" />
    </Grid>
</UserControl>
